# 212LEARN Frontend Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development

# API Base URL (default local: http://localhost:5000/api/v1, production: https://backend-212learn.vercel.app/api/v1)
# For local development: http://localhost:5000/api/v1
# For production: https://backend-212learn.vercel.app/api/v1
VITE_API_BASE_URL=https://backend-212learn.vercel.app/api/v1

# Application branding title
VITE_APP_NAME=212LEARN

# Optional: Cloudinary Cloud Name (if using direct Cloudinary uploads)
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Virtual classroom — MiroTalk SFU server base URL.
# Leave unset to use the public MiroTalk demo instance (fine for testing);
# set to your self-hosted server for production (no active-user/month cap).
# VITE_MIROTALK_URL=https://sfu.your-domain.com

# Optional: Enable/Disable features
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_NOTIFICATIONS=true
